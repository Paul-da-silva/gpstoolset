# DocumentRoot is this directory. Config, includes, and tools live outside it.
# Real files (assets, robots.txt, favicon) are served as files.
# Every other route goes to index.php, which reads config/tools.php.

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # tools/ lives above the document root. Never serve it as a URL.
    RewriteRule ^tools(/|$) - [F,L]

    # /index.php -> /
    # THE_REQUEST avoids a loop with the internal rewrite below.
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Old *.php stubs from before the front controller.
    RewriteRule ^privacy\.php$ /privacy [R=301,L]
    RewriteRule ^about\.php$ /about [R=301,L]
    RewriteRule ^gopro\.php$ /gopro-gps-extract [R=301,L]
    RewriteRule ^gopro-gps-extract\.php$ /gopro-gps-extract [R=301,L]

    # Legacy path from before the tool URL was renamed.
    RewriteRule ^gopro/?$ /gopro-gps-extract [R=301,L]

    # Old one-way converters now live under /convert/.
    RewriteRule ^kml-to-gpx/?$ /convert/kml-to-gpx [R=301,L]
    RewriteRule ^gpx-to-kml/?$ /convert/gpx-to-kml [R=301,L]
    RewriteRule ^fit-to-gpx/?$ /convert/fit-to-gpx [R=301,L]

    # One canonical path without a trailing slash.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # A missing file under assets/ is a plain 404, not an HTML page.
    RewriteRule ^assets/ - [L]

    # Everything that is not a real file or directory is a routed page
    # (including /sitemap.xml, which is generated).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# JS and CSS have no hashed names. Revalidate so a reload cannot keep an old module.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
